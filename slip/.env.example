# Copy this file to .env.local and fill in your keys. Never commit .env.local.

# The Odds API — https://the-odds-api.com (free tier: 500 credits/month).
# Optional: without it, Slip shows one sportsbook's line from ESPN.
ODDS_API_KEY=

# Which sportsbook regions to compare: us, us2, uk, eu, au (comma-separated).
# Each extra region multiplies credit cost.
ODDS_REGIONS=us

# balldontlie — https://www.balldontlie.io (optional, currently unused: ESPN provides
# game logs for free, and balldontlie's free tier doesn't include stats).
BALLDONTLIE_API_KEY=

# Include player props in "Picks for you": on/off. Costs 5 Odds API credits per game
# per refresh (about 40 credits for an 8-game night), more than the free tier can
# sustain daily. Recommended only on a paid Odds API plan.
AUTO_PROPS=off

# How long to reuse API responses before fetching again (minutes).
ODDS_CACHE_MINUTES=60
ESPN_CACHE_MINUTES=10
